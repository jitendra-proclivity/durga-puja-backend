# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/durga-puja?retryWrites=true&w=majority

# Any long random string (used to sign login tokens)
JWT_SECRET=replace-this-with-a-long-random-string

# Cloudinary (Dashboard → Account Details)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# The first admin login (used once by `npm run seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-password

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

PORT=5000
